#!/usr/bin/python3 -I
"""sg-bt-agent: agente de emparejamiento Bluetooth para Serpantinum.

Serpantinum puede emparejar desde su panel (device.pair()), pero no trae un "agente": el programa
que responde "¿aceptas este dispositivo?". Sin agente, BlueZ rechaza el emparejamiento
("No agent available"). Este agente pregunta con una notificación de Serpantinum:

    Rechazar (primera acción: un clic accidental en la notificación RECHAZA) · Aceptar

Sin respuesta en 30 s se rechaza. Nunca acepta solo.

Además, completa la conexión después de emparejar: el panel llama a device.connect() apenas termina
el emparejamiento, pero en ese momento BlueZ todavía marca Connected (es el enlace que usó para
emparejar), y Quickshell se niega ("is already connected"). Queda emparejado pero sin audio. Para
parlantes, audífonos, mouse y teclados, el agente le pide Connect() a BlueZ directamente.

Y ayuda cuando un dispositivo "olvida" la laptop (por ejemplo, un parlante que se reinició o se
emparejó con otro equipo): el dispositivo pide emparejarse de nuevo, pero con la opción por defecto
de BlueZ (JustWorksRepairing = never) se rechaza sin preguntar y queda "conectado" sin audio. Con
JustWorksRepairing = confirm, BlueZ se lo pregunta a este agente, que avisa que es un re-emparejamiento.
"""
import os
import subprocess
import sys

import dbus
import dbus.mainloop.glib
import dbus.service
from gi.repository import GLib

BLUEZ = os.environ.get("SG_BT_BUS_NAME", "org.bluez")
AGENT_PATH = "/org/serpantinum/btagent"
CAPABILITY = "DisplayYesNo"      # puede mostrar un código y preguntar sí/no; no puede escribir
TIMEOUT = 30                     # segundos para responder (BlueZ espera hasta 60)
NOTIFY = os.environ.get("SG_BT_NOTIFY", "notify-send")
CONNECT_ICONS = ("audio-", "input-")  # se conectan solos al emparejar; celulares y laptops no
CONNECT_DELAY = 2                # segundos: deja terminar al panel antes de pedir la conexión
REPAIR_CONNECT_DELAY = 4         # segundos: después de aceptar un re-emparejamiento
MAIN_CONF = os.environ.get("SG_BT_MAIN_CONF", "/etc/bluetooth/main.conf")


def log(msg):
    print(msg, file=sys.stderr, flush=True)


class Rejected(dbus.DBusException):
    _dbus_error_name = "org.bluez.Error.Rejected"


class Canceled(dbus.DBusException):
    _dbus_error_name = "org.bluez.Error.Canceled"


def device_alias(path):
    try:
        props = dbus.Interface(bus.get_object(BLUEZ, path), "org.freedesktop.DBus.Properties")
        name = str(props.Get("org.bluez.Device1", "Alias"))
        return "".join(c for c in name if c.isprintable())[:64] or "Un dispositivo"
    except dbus.DBusException:
        return "Un dispositivo"


def is_paired(path):
    try:
        props = dbus.Interface(bus.get_object(BLUEZ, path), "org.freedesktop.DBus.Properties")
        return bool(props.Get("org.bluez.Device1", "Paired"))
    except dbus.DBusException:
        return False


def set_trusted(path):
    try:
        props = dbus.Interface(bus.get_object(BLUEZ, path), "org.freedesktop.DBus.Properties")
        props.Set("org.bluez.Device1", "Trusted", dbus.Boolean(True))
    except dbus.DBusException as e:
        log(f"no se pudo marcar como de confianza: {e}")


def notify(title, body):
    subprocess.Popen([NOTIFY, "--app-name=Bluetooth", "--icon=bluetooth", title, body],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


class Agent(dbus.service.Object):
    def __init__(self, conn, path):
        super().__init__(conn, path)
        self.pending = None          # (Popen, reply, error, device) de la pregunta en curso

    # --- pregunta asíncrona: no bloquea el bucle mientras el usuario decide ---
    def _ask(self, device, title, body, reply, error, on_yes=None):
        self._cancel_pending()
        try:
            proc = subprocess.Popen(
                [NOTIFY, "--app-name=Bluetooth", "--icon=bluetooth", "--urgency=critical",
                 f"--expire-time={TIMEOUT * 1000}",
                 "--action=no=Rechazar", "--action=yes=Aceptar", title, body],
                stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
        except OSError as e:
            log(f"no se pudo mostrar la notificación: {e}")
            error(Rejected("Sin forma de preguntar"))
            return
        self.pending = (proc, reply, error, device)
        started = GLib.get_monotonic_time()

        def poll():
            if self.pending is None or self.pending[0] is not proc:
                return False                     # se canceló
            if proc.poll() is None:
                if GLib.get_monotonic_time() - started > TIMEOUT * 1_000_000:
                    self.pending = None
                    proc.terminate()
                    error(Rejected("Sin respuesta"))
                    return False
                return True
            self.pending = None
            answer = (proc.stdout.read() or "").strip()
            if answer == "yes":
                set_trusted(device)
                log(f"aceptado: {device}")
                reply()
                if on_yes is not None:
                    on_yes()
            else:
                log(f"rechazado: {device} ({answer or 'cerrada'})")
                error(Rejected("Rechazado por el usuario"))
            return False

        GLib.timeout_add(200, poll)

    def _cancel_pending(self):
        """Cierra la pregunta en curso y le responde a BlueZ que se canceló (nunca la acepta)."""
        if self.pending is not None:
            proc, _reply, error, _device = self.pending
            self.pending = None
            if proc.poll() is None:
                proc.terminate()
            error(Canceled("Cancelado"))

    # --- métodos de org.bluez.Agent1 ---
    @dbus.service.method("org.bluez.Agent1", in_signature="", out_signature="")
    def Release(self):
        log("BlueZ liberó el agente")

    @dbus.service.method("org.bluez.Agent1", in_signature="ou", out_signature="",
                         async_callbacks=("reply", "error"))
    def RequestConfirmation(self, device, passkey, reply, error):
        name = device_alias(device)
        self._ask(device, f"¿Emparejar {name}?",
                  f"Comprueba que el código sea {int(passkey):06d} en los dos equipos.", reply, error)

    @dbus.service.method("org.bluez.Agent1", in_signature="o", out_signature="",
                         async_callbacks=("reply", "error"))
    def RequestAuthorization(self, device, reply, error):
        name = device_alias(device)
        if is_paired(device):
            # Re-emparejamiento: el dispositivo perdió su llave. Puede ser normal (se reinició, se
            # emparejó con otro equipo) o alguien que se hace pasar por él: por eso se dice claro.
            log(f"re-emparejamiento pedido: {device}")
            self._ask(device, f"¿Volver a emparejar {name}?",
                      "Ya estaba emparejado y pide emparejarse de nuevo: perdió la llave de esta "
                      "laptop. Acepta solo si lo reiniciaste o lo emparejaste con otro equipo.",
                      reply, error,
                      on_yes=lambda: GLib.timeout_add_seconds(REPAIR_CONNECT_DELAY,
                                                              connect_after_pairing, device))
            return
        self._ask(device, f"¿Emparejar {name}?",
                  "Un dispositivo quiere emparejarse con esta laptop.", reply, error)

    @dbus.service.method("org.bluez.Agent1", in_signature="os", out_signature="",
                         async_callbacks=("reply", "error"))
    def AuthorizeService(self, device, uuid, reply, error):
        self._ask(device, f"¿Permitir a {device_alias(device)}?",
                  "Quiere usar un servicio de Bluetooth.", reply, error)

    @dbus.service.method("org.bluez.Agent1", in_signature="ouq", out_signature="")
    def DisplayPasskey(self, device, passkey, entered):
        if int(entered) == 0:   # solo la primera vez, no en cada tecla
            notify(f"Emparejar {device_alias(device)}",
                   f"Escribe {int(passkey):06d} en el dispositivo y presiona Enter.")

    @dbus.service.method("org.bluez.Agent1", in_signature="os", out_signature="")
    def DisplayPinCode(self, device, pincode):
        notify(f"Emparejar {device_alias(device)}", f"Escribe {pincode} en el dispositivo.")

    @dbus.service.method("org.bluez.Agent1", in_signature="o", out_signature="s")
    def RequestPinCode(self, device):
        notify("Bluetooth", f"{device_alias(device)} pide escribir un PIN: emparéjalo con bluetoothctl.")
        raise Rejected("Este agente no puede escribir códigos")

    @dbus.service.method("org.bluez.Agent1", in_signature="o", out_signature="u")
    def RequestPasskey(self, device):
        notify("Bluetooth", f"{device_alias(device)} pide escribir un código: emparéjalo con bluetoothctl.")
        raise Rejected("Este agente no puede escribir códigos")

    @dbus.service.method("org.bluez.Agent1", in_signature="", out_signature="")
    def Cancel(self):
        log("BlueZ canceló la solicitud")
        self._cancel_pending()


def register():
    manager = dbus.Interface(bus.get_object(BLUEZ, "/org/bluez"), "org.bluez.AgentManager1")
    manager.RegisterAgent(AGENT_PATH, CAPABILITY)
    manager.RequestDefaultAgent(AGENT_PATH)
    log(f"agente registrado ({CAPABILITY}) y como predeterminado")


def connect_after_pairing(path):
    try:
        props = dbus.Interface(bus.get_object(BLUEZ, path), "org.freedesktop.DBus.Properties")
        paired = bool(props.Get("org.bluez.Device1", "Paired"))
        icon = str(props.Get("org.bluez.Device1", "Icon"))
    except dbus.DBusException:
        return False                 # si no se puede confirmar qué es, no se conecta
    if not paired or not icon.startswith(CONNECT_ICONS):
        return False
    dev = dbus.Interface(bus.get_object(BLUEZ, path), "org.bluez.Device1")
    # Si el panel ya lo conectó, BlueZ responde AlreadyConnected o InProgress: no pasa nada
    dev.Connect(timeout=60,
                reply_handler=lambda: log(f"conectado después de emparejar: {path}"),
                error_handler=lambda e: log(f"conectar después de emparejar: {path}: {e.get_dbus_name()}"))
    return False                     # una sola vez (GLib.timeout_add_seconds)


def on_device_changed(interface, changed, _invalidated, path=None):
    if interface == "org.bluez.Device1" and bool(changed.get("Paired", False)):
        GLib.timeout_add_seconds(CONNECT_DELAY, connect_after_pairing, path)


def check_repairing_policy():
    """Avisa en el registro si BlueZ rechaza en silencio los re-emparejamientos."""
    value, section = "never", ""
    try:
        with open(MAIN_CONF, encoding="utf-8", errors="replace") as f:
            for line in f:
                line = line.strip()
                if line.startswith("["):
                    section = line
                elif section == "[General]" and line.split("=")[0].strip() == "JustWorksRepairing":
                    value = line.split("=", 1)[1].strip() if "=" in line else value
    except OSError:
        return
    if value not in ("confirm", "always"):     # igual que BlueZ: lo desconocido cuenta como never
        log(f"aviso: JustWorksRepairing = {value} en {MAIN_CONF}. Si un dispositivo olvida esta "
            "laptop, BlueZ rechaza que se vuelva a emparejar sin preguntar. Recomendado: "
            "JustWorksRepairing = confirm en [General] (ver el README).")


def on_bluez_owner(new_owner):
    if new_owner:                # BlueZ arrancó o se reinició: volver a registrarse
        try:
            register()
        except dbus.DBusException as e:
            log(f"no se pudo registrar: {e}")


if __name__ == "__main__":
    dbus.mainloop.glib.DBusGMainLoop(set_as_default=True)
    bus = dbus.SessionBus() if os.environ.get("SG_BT_TEST_SESSION_BUS") else dbus.SystemBus()
    agent = Agent(bus, AGENT_PATH)
    check_repairing_policy()
    bus.watch_name_owner(BLUEZ, on_bluez_owner)
    # bus_name: solo las señales de BlueZ (dbus-python sigue al nuevo dueño si BlueZ se reinicia)
    bus.add_signal_receiver(on_device_changed, signal_name="PropertiesChanged",
                            dbus_interface="org.freedesktop.DBus.Properties", arg0="org.bluez.Device1",
                            bus_name=BLUEZ, path_keyword="path")
    GLib.MainLoop().run()
